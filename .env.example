DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Full production URL of the webhook endpoint, e.g. https://prformm.vercel.app/api/strava/webhook
# Must be the production domain ? never a preview deployment URL
STRAVA_WEBHOOK_CALLBACK_URL=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend). If RESEND_API_KEY is unset, email sends no-op
# (a warning is logged) so local dev never breaks.
RESEND_API_KEY=
# From address. Defaults to "PRform <onboarding@resend.dev>" until a custom
# domain is verified in Resend.
EMAIL_FROM=
# Shared secret guarding /api/cron/strava-reminders. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" when this env var is set.
CRON_SECRET=
