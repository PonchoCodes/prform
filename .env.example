DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Integration tests only (npm run test:integration) — a SEPARATE database that
# the tests truncate between cases. Create it with `node scripts/createTestDb.mjs`.
# The database name must contain "test": tests/integration/db.ts refuses to run
# against anything else, so a stray production URL here fails loudly rather than
# wiping real data.
TEST_DATABASE_URL=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Full production URL of the webhook endpoint, e.g. https://prformm.vercel.app/api/strava/webhook
# Must be the production domain ? never a preview deployment URL
STRAVA_WEBHOOK_CALLBACK_URL=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend). If RESEND_API_KEY is unset, email sends no-op
# (a warning is logged) so local dev never breaks.
RESEND_API_KEY=
# From address. Defaults to "PRform <onboarding@resend.dev>" until a custom
# domain is verified in Resend.
EMAIL_FROM=
# Shared secret guarding /api/cron/strava-reminders and /api/cron/messaging.
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" when set.
CRON_SECRET=

# ── SMS ──────────────────────────────────────────────────────────────────────
# Log every message and recipient, hand nothing to Twilio. DEFAULTS TO TRUE:
# real sending has to be switched on deliberately, so that a missing variable in
# a new environment cannot start texting people. Set to "false" only once the
# DRY_RUN output has been reviewed.
SMS_DRY_RUN=true

# Global brake. Any truthy value halts all outbound messages immediately.
# STOP and HELP still work while this is on — Twilio's Advanced Opt-Out answers
# both at the Messaging Service, without reaching this app.
SMS_KILL_SWITCH=false

# Hard ceiling on messages to one athlete in one of their local days, enforced
# in code against the SentMessage ledger. Default 5.
SMS_MAX_PER_USER_PER_DAY=5

# Twilio. TWILIO_MESSAGING_SERVICE_SID is not optional: message scheduling
# requires a Messaging Service, and a bare "from" number cannot schedule.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# The exact public URL Twilio posts inbound messages to. Signature verification
# hashes the URL Twilio signed, so this must match byte for byte — scheme, host
# and path — or every inbound is rejected as unsigned.
TWILIO_INBOUND_WEBHOOK_URL=

# ── Web push ─────────────────────────────────────────────────────────────────
# Generate once with `npm run push:keys`, then paste the pair here and into the
# Vercel project settings. ROTATING THESE UNSUBSCRIBES EVERY DEVICE: a browser
# subscription is minted against one public key and a push service rejects a
# request signed by any other. Absent or malformed values disable push entirely
# rather than failing at send time.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https:// — how a push service contacts you about abuse. Required.
VAPID_SUBJECT=mailto:help@prform.app

# Global brake for push, separate from SMS_KILL_SWITCH so stopping one channel
# does not silence the other.
PUSH_KILL_SWITCH=false

# ── Email as a message channel ───────────────────────────────────────────────
# Uses the same RESEND_API_KEY as the transactional email above. Resend accepts
# a scheduledAt, so email is the only channel besides SMS that can hold a future
# message: an athlete on EMAIL gets working scheduled reminders with no
# five-minute flush trigger. See COSTS.md.
EMAIL_KILL_SWITCH=false
