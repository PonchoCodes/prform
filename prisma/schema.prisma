generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  age              Int?
  biologicalSex    String?
  weeklyMileage    String?
  experienceLevel  String?
  onboardingDone   Boolean @default(false)
  /// When onboarding was finished. The boolean above says whether; this says
  /// when, which is the only form a funnel can use — "signed up in week 12 and
  /// completed onboarding" is a question about two dates, and a flag cannot
  /// answer it. Backfilled to `createdAt` for accounts that finished before
  /// this column existed; those rows understate the gap between the two steps
  /// rather than inventing one, and the retention page says so.
  onboardingCompletedAt DateTime?
  sport            String? @default("track")

  currentWakeTime  String?
  currentBedTime   String?
  restedFeeling    String?

  // Declared personal best, used to derive training paces before any workout
  // history exists. All nullable — existing users have none and fall back to
  // history-inferred paces. VDOT is derived from these on read rather than
  // stored, so a change to the model never leaves a stale cached value behind.
  prDistanceId        String?
  prTimeSeconds       Float?
  prRecency           String?   // bucket id, e.g. "3_6m" — shown back to the user
  prSetOn             DateTime? // representative date derived from prRecency
  goalRaceDistanceId  String?
  prPromptDismissedAt DateTime? // existing-user prompt, dismissed once and stays dismissed

  notifPhase1      Boolean @default(true)
  notifPhase2      Boolean @default(true)
  notifPhase3      Boolean @default(true)
  notifPhase4      Boolean @default(true)

  stravaAccessToken   String?
  stravaRefreshToken  String?
  stravaTokenExpiry   DateTime?
  stravaAthleteId     String?
  stravaConnected              Boolean   @default(false)
  lastStravaSyncAt             DateTime?
  userMaxHR                    Int?
  userThresholdHR     Int?

  planAggressiveness       Int @default(85)
  bedtimeAdjustmentMinutes Int @default(0)
  unitPreference           String @default("imperial")

  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionStatus     String?
  trialEndsAt            DateTime?

  approved          Boolean @default(false)
  earlyAccessUser   Boolean @default(false)

  // Strava connection follow-up: when the user was approved off the waitlist,
  // and when each of the two connect-Strava reminder emails was sent.
  approvedAt         DateTime?
  stravaReminder1At  DateTime?
  stravaReminder2At  DateTime?

  // ── SMS layer ──────────────────────────────────────────────────────────────
  // Always stored E.164-normalized ("+15551234567"). Unique for two reasons,
  // both load-bearing: an inbound webhook identifies the sender only by their
  // number, so a duplicate would make routing ambiguous; and it is the one
  // schema-level guarantee that a coach cannot attach an athlete's number to a
  // second account. Nullable-unique in Postgres permits many NULLs, so users
  // without SMS are unaffected.
  phoneNumber     String?   @unique
  // Set only after a verification code is confirmed. Null means never send.
  phoneVerifiedAt DateTime?
  // IANA identifier, e.g. "America/New_York". Never a UTC offset — an offset is
  // wrong for half the year and would put a lights-out text an hour off.
  ianaTimezone    String?
  smsOptInAt      DateTime?
  // The exact consent copy the athlete agreed to, captured verbatim at opt-in.
  // Stored rather than referenced so that later edits to the wording cannot
  // rewrite what a past user actually consented to.
  smsOptInText    String?
  smsStatus       SmsStatus @default(UNVERIFIED)

  // ── Web push ───────────────────────────────────────────────────────────────
  /// Which channel the scheduled evening and morning messages go out on.
  /// AUTO is the only value anything sets today and resolves per athlete in
  /// lib/messaging/channel.ts. The explicit values exist so an athlete who has
  /// both a verified number and a subscribed device can say which they want,
  /// and so support can pin someone to one channel while diagnosing.
  channelPreference ChannelPreference @default(AUTO)
  /// First time this athlete allowed notifications on any device. Kept as the
  /// consent timestamp for the channel; the subscriptions themselves come and
  /// go as devices are wiped and browsers prune them.
  pushOptInAt       DateTime?
  /// When they dismissed the "install the app" notice. Stored on the user
  /// rather than in localStorage so dismissing it on the phone also silences it
  /// on the laptop — being nagged on every device is how a notice becomes
  /// something people learn to ignore.
  installPromptDismissedAt DateTime?

  workouts         Workout[]
  meets            Meet[]
  sessions         Session[]
  stravaActivities StravaActivity[]
  sleepLogs        SleepLog[]
  sentMessages     SentMessage[]
  inboundMessages  InboundMessage[]
  phoneVerifications PhoneVerification[]
  pushSubscriptions  PushSubscription[]
  streakHolds        StreakHold[]
  ownedTeams       Team[]           @relation("OwnedTeams")
  teamMemberships  TeamMembership[]
}

/// A stretch of days the athlete has marked as away.
///
/// Days inside a hold are neither counted nor missed by the check-in streak:
/// they are removed from the question entirely, so a fortnight in hospital or a
/// week at a training camp with no phone leaves a 40-day streak intact at 40.
///
/// Deliberately NOT a freeze, and the difference is the whole design. A freeze
/// is a token with a balance, and a balance is a second thing to check, earn
/// and be reminded about — this app's messaging is built to stay under an
/// athlete's attention threshold, and a currency works against that. A hold has
/// no balance, no cost, and nothing to spend. You say when you are away.
///
/// There is no limit on how many an athlete may take. Someone who marks every
/// day as a hold has a streak of zero, because a held day is not a checked-in
/// day either — the mechanic cannot be farmed, which is why it needs no rules.
model StreakHold {
  id     String @id @default(cuid())
  userId String

  /// Inclusive, "YYYY-MM-DD" as a UTC-midnight instant, the same shape
  /// SleepLog.date uses so the two can be compared without conversion.
  startsOn DateTime
  /// Inclusive. A single day is a hold with startsOn == endsOn.
  endsOn   DateTime

  /// Free text, optional. Never shown to anyone but the athlete.
  reason String?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The streak query: every hold for one athlete, newest range first.
  @@index([userId, startsOn])
}

/// Which transport a message went out on, or should go out on.
enum MessageChannel {
  SMS
  PUSH
  /// Resend. The only channel besides SMS that can hold a future message for
  /// us, which is what lets a once-daily cron schedule an evening reminder.
  EMAIL
}

/// An athlete's stated channel choice. AUTO defers to whatever they have set
/// up, resolved in lib/messaging/channel.ts.
enum ChannelPreference {
  AUTO
  SMS
  PUSH
  EMAIL
}

/// One browser, on one device, that has agreed to receive notifications.
///
/// A row per device, not per athlete: someone with a phone and a laptop has
/// two, and a message goes to all of them. Rows are disposable — a browser
/// prunes a subscription whenever it feels like it, and a reinstalled PWA
/// issues a fresh endpoint — so nothing may treat a subscription as durable
/// identity. The durable consent record is User.pushOptInAt.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  /// The push service URL the browser minted for us. Unique because it IS the
  /// identity of the subscription: the same device re-subscribing returns the
  /// same endpoint, and inserting a second row would double-send to it.
  endpoint String @unique
  /// The subscription's public key and auth secret, base64url, straight from
  /// the browser. Together with our VAPID private key these encrypt the
  /// payload — the push service relays ciphertext it cannot read.
  p256dh String
  auth   String

  /// What the browser reported at subscribe time. Kept for the iOS diagnosis
  /// (an iOS subscription can only exist inside an installed PWA) and to make
  /// "notifications stopped working on Android" answerable.
  userAgent String?
  /// "ios" | "ipados" | "android" | "desktop" | "unknown", as classified by
  /// lib/pwa/install.ts. Denormalized from userAgent so a query can group by it.
  platform  String?

  createdAt DateTime @default(now())
  /// Refreshed every time the browser re-registers, which it does on each load
  /// of the app. A stale value is the signal that a device is gone.
  lastSeenAt    DateTime @default(now())
  lastSuccessAt DateTime?

  /// Consecutive delivery failures. A push service returning 404 or 410 means
  /// the subscription is dead and the row is deleted outright; this counts the
  /// ambiguous failures (timeouts, 5xx) that should not delete anything on the
  /// strength of one bad night.
  failureCount Int @default(0)
  /// Set when the row is retired without being deleted. Never sent to, kept so
  /// that "this device used to work" survives in the record.
  disabledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The send path's only query: every live subscription for one athlete.
  @@index([userId, disabledAt])
}

/// UNVERIFIED is the default and the safe state: no message may be sent in it.
/// STOPPED is terminal until the athlete opts in again themselves.
enum SmsStatus {
  UNVERIFIED
  ACTIVE
  STOPPED
}

enum WaitlistRole {
  RUNNER
  COACH
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

model Waitlist {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  role          WaitlistRole
  weeklyMileage Int?
  usesStrava    Boolean
  notes         String?
  status        WaitlistStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  approvedAt    DateTime?
}

model StravaActivity {
  id              String   @id @default(cuid())
  stravaId        String   @unique
  userId          String
  name            String
  startDate       DateTime
  distance        Float
  movingTime      Int
  elapsedTime     Int
  totalElevGain   Float
  averageSpeed    Float
  maxSpeed        Float
  averageHeartrate Float?
  maxHeartrate    Float?
  sufferScore     Int?
  workoutType     Int?
  averageCadence  Float?
  externalId      String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  expires      DateTime
  sessionToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workout {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  type              String
  distance          Float?
  duration          Int?
  /// Session RPE, 1–10 (Foster scale). With `duration`, this is the whole
  /// manual training-load story: duration × RPE feeds ATL/CTL/TSB exactly the
  /// way device-derived stress does, so an athlete with no Strava still gets
  /// the fatigue branch of the verdict. Named `effort` for continuity — the
  /// column predates the load model and the API already reads/writes it.
  effort            Int?
  /// How the session went, self-reported after the fact. The no-Strava
  /// alternative to pace compliance: the trend chart scores NAILED_IT and FINE
  /// as on-target, ROUGH as off. Null means never asked or never answered —
  /// which is missing data, not a rough day.
  quality           WorkoutQuality?
  isTemplate        Boolean  @default(false)
  dayOfWeek         Int?
  isTentative       Boolean  @default(false)
  manualOverride    Boolean  @default(false)
  conflictDismissed Boolean  @default(false)
  stravaActivityId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Self-reported session quality. Three values on purpose: a 1–10 "how was
/// it?" collapses into the same three answers with false precision, and the
/// athlete answering from a phone in a hallway needs a tap, not a rating task.
enum WorkoutQuality {
  NAILED_IT
  FINE
  ROUGH
}

model Meet {
  id               String   @id @default(cuid())
  userId           String
  name             String
  date             DateTime
  distances        String
  priority         String
  raceTime         String?
  primaryEvent     String?
  personalBest     String?
  recentBest       String?
  personalBestUnit String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SleepLog {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime
  recommendedBedtime String
  // The rest of the plan's target for that night, captured at log time. The
  // plan is recomputed on every request, so by the time a trend is drawn the
  // original target is gone — a meet ramp or a changed wake time would
  // silently rewrite history. Nullable: nights logged before this shipped
  // have no target and are excluded from the debt series rather than guessed.
  recommendedWakeTime String?
  targetSleepHours   Float?
  hitTarget          Boolean?
  actualBedtime      String?
  actualWakeTime     String?
  actualSleepHours   Float?

  // ── Instants, as opposed to the "HH:MM" strings above ──────────────────────
  // The string columns cannot express a night at all: they carry a clock face
  // with no date, so a duration derived from them is modular and a bed-at-23:00
  // / wake-at-22:00 pair scores 23 hours with no way to tell that from a real
  // one. These three are real timestamps, so a duration computed from them is
  // either right or obviously wrong.
  //
  // sleepOnsetAt   — when the athlete actually went down. For a "BED" reply this
  //                  is the message receipt timestamp, which is why it is an
  //                  instant and not a reported time.
  // wakeAt         — when they actually got up.
  // declaredWakeAt — the wake time they told us the evening before. The anchor
  //                  the bedtime is computed backward from, kept so that a plan
  //                  can be audited against what was known when it was made.
  sleepOnsetAt   DateTime?
  wakeAt         DateTime?
  declaredWakeAt DateTime?

  /// 0–1. How much the duration on this row can be trusted: a timestamped night
  /// is near 1, a recalled one lower, an inferred one lower still. Null on rows
  /// that predate the SMS layer rather than guessed at.
  confidence Float?

  source     SleepSource @default(MANUAL)
  /// Set when the night could not be scored — a duration outside the plausible
  /// window, or two BED replies with no UP between them. The row is kept, but
  /// every consumer that averages durations must exclude it.
  needsReview     Boolean  @default(false)
  needsReviewNote String?

  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Where a night's sleep timing came from, in descending order of trust.
/// TIMESTAMPED — a "BED"/"UP" text; the instant is our own receipt time.
/// RECALLED    — the athlete told us a time after the fact ("I got down at 11").
/// INFERRED    — no signal arrived and we closed the record at the declared wake.
/// MANUAL      — logged through the website. Every pre-SMS row is this.
enum SleepSource {
  TIMESTAMPED
  RECALLED
  INFERRED
  MANUAL
}

/// Every outbound message, whether scheduled, sent, or only logged by DRY_RUN.
/// This table is the send ledger: the per-user daily cap is counted from it, so
/// nothing may go out without a row here first.
model SentMessage {
  id     String @id @default(cuid())
  userId String

  /// The athlete's local calendar date, "YYYY-MM-DD" in their own timezone.
  /// Deliberately a string and not a DateTime. SleepLog.date is a DateTime
  /// pinned to UTC midnight, and that pattern is precisely what makes local-date
  /// reasoning error-prone here — a DateTime invites comparison against an
  /// instant, and "the athlete's Tuesday" is not an instant.
  localDate   String
  messageType MessageType

  /// Which transport carried it. Defaults to SMS so every row written before
  /// push existed reads correctly rather than as an unknown.
  ///
  /// The unique constraint below still spans (user, day, type) with no channel
  /// in it, and that is deliberate: the evening question is one message, and
  /// sending it by push *and* text because the athlete has both would be two
  /// interruptions for one thought. The channel is resolved before the row is
  /// written, and the row is the record of which one won.
  channel MessageChannel @default(SMS)

  /// The UTC instant we asked the provider to send at. Null for an immediate
  /// send. Twilio requires this to be 15 min – 35 days out.
  ///
  /// For push it means something slightly different — nobody is holding the
  /// message but us. A push service has no scheduling API, so a row with a
  /// future `scheduledFor` and status SCHEDULED is a message waiting for the
  /// flush pass (lib/messaging/pushFlush.ts) to notice it is due.
  scheduledFor DateTime?
  /// When it actually went out. Null while still SCHEDULED.
  sentAt       DateTime?

  /// Twilio's SM… identifier. Null under DRY_RUN. This is what makes a
  /// scheduled message cancellable: on STOP, or when the athlete revises a wake
  /// time we have already scheduled around, we cancel by this SID. Without it
  /// stored, an opt-out at 9pm cannot stop the 6am message already queued.
  providerMessageSid String?
  status             MessageStatus

  /// The exact text sent, kept verbatim for the DRY_RUN review and for any
  /// later dispute about what an athlete was actually told.
  body String

  /// How many times this (user, day, type) has been sent. The unique constraint
  /// below collapses repeats onto one row, which would otherwise let the daily
  /// cap undercount the genuinely repeatable types — a clarification reply, or
  /// a second BED acknowledgment on a split night.
  sendCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The retry guard. A cron that runs twice, or overlapping daily windows,
  /// collide here instead of texting someone the same thing twice.
  @@unique([userId, localDate, messageType])
  /// Status callbacks arrive keyed by SID alone.
  @@index([providerMessageSid])
  /// Drives the cancellation sweep and the housekeeping pass.
  @@index([status, scheduledFor])
}

enum MessageType {
  /// "What time are you up tomorrow?" — scheduled ~90 min before computed bedtime.
  EVENING_WAKE_QUESTION
  /// "Then lights out by 8:15. Reply BED when you're down." — immediate reply.
  LIGHTS_OUT
  /// "Got it — 8:31. Sleep well." — immediate reply.
  BED_ACK
  /// The verdict, scheduled for the declared wake time.
  MORNING_VERDICT
  /// Sent when nothing parsed. Asks; never guesses.
  CLARIFICATION
  /// Mandatory carrier-required replies. Must work in every state, always.
  HELP_REPLY
  STOP_ACK
  /// Step 8 phone verification.
  VERIFICATION_CODE
}

enum MessageStatus {
  /// Composed and logged, handed to no provider. The DRY_RUN terminal state.
  DRY_RUN
  /// Accepted by the provider with a future send time; cancellable.
  SCHEDULED
  SENT
  DELIVERED
  FAILED
  CANCELED
}

/// Every inbound message, stored before it is interpreted. The raw body is kept
/// verbatim because the parser will be wrong about real messages in ways no test
/// table anticipates, and the only way to fix it is to read what people actually
/// wrote.
model InboundMessage {
  id String @id @default(cuid())

  /// Null when the sending number matches no user. An unrecognized inbound is
  /// still recorded — that case is evidence about a routing or verification bug,
  /// and discarding it would hide exactly the problem worth seeing.
  userId     String?
  fromNumber String

  /// Exactly what arrived: original case, spacing, punctuation, and emoji. Never
  /// trimmed or upper-cased on the way in — normalization belongs to the parser,
  /// and this column is the record of what the parser was given.
  rawBody String

  /// What the parser made of it. UNPARSED is a real, expected outcome.
  intent InboundIntent
  /// The normalized payload, when there is one: "05:30" for a wake time, minutes
  /// for a duration. Null for intents that carry no value.
  parsedValue String?

  /// Our receipt timestamp. For a BED reply this becomes SleepLog.sleepOnsetAt,
  /// which is why it is recorded here rather than derived later.
  receivedAt         DateTime
  providerMessageSid String?

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@index([providerMessageSid])
  @@index([intent])
}

/// STOP and UNSUBSCRIBE both normalize to STOP — they mean the same thing, and
/// the branch that honours them must not depend on which word was used.
enum InboundIntent {
  STOP
  HELP
  BED
  UP
  WAKE_TIME
  DURATION
  UNPARSED
}

// ── Team layer ───────────────────────────────────────────────────────────────

model Team {
  id      String  @id @default(cuid())
  name    String
  sport   String  @default("track")
  season  String?

  /// Whoever made the team. Called the owner and not the coach because a
  /// captain running a group chat for six people is as legitimate an owner as
  /// a salaried coach, and the earlier name quietly said otherwise — it made
  /// the athlete who organizes the team feel like they were using the wrong
  /// product. The permissions are identical either way; only the word changed.
  ownerId String

  /// Athletes join themselves with this code — it is the ONLY path onto a
  /// team. There is deliberately no API that lets an owner attach a user:
  /// many athletes are minors, and enrolment has to be an act the athlete
  /// performs, on their own account, past a consent screen.
  joinCode          String   @unique
  joinCodeExpiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner           User             @relation("OwnedTeams", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships     TeamMembership[]
  plannedSessions PlannedSession[]

  @@index([ownerId])
}

model TeamMembership {
  id     String @id @default(cuid())
  teamId String
  userId String

  role     MembershipRole   @default(ATHLETE)
  joinedAt DateTime         @default(now())
  /// When the athlete accepted the consent screen — set at join, required.
  consentAt DateTime
  /// The exact consent copy shown at join, stored verbatim (same rationale as
  /// smsOptInText: later edits to the wording must not rewrite what a past
  /// athlete actually agreed to).
  consentText String
  status      MembershipStatus @default(ACTIVE)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum MembershipRole {
  ATHLETE
}

enum MembershipStatus {
  ACTIVE
  /// The athlete left. Kept rather than deleted so the consent record survives.
  LEFT
  /// The owner removed them. Same reasoning.
  REMOVED
}

/// A session the owner plans for the whole team. Feeds each member's sleep
/// plan and verdict through the workout merge layer, so the planned-session
/// branch works with no Strava and no athlete input at all.
model PlannedSession {
  id     String @id @default(cuid())
  teamId String

  date        DateTime
  /// One of the app's WorkoutType strings ("easy" | "tempo" | "track" | …).
  sessionType String
  /// How long the owner expects the session to take. Required, and with no
  /// default on purpose: the merge layer used to hand every team session a
  /// nominal hour, which quietly fed a guess into the athlete's training-load
  /// bonus. The owner knows the number; the algorithm should not invent it.
  durationMinutes Int
  description String?
  /// Free text ("5x1k @ 3:45/km"). Display-only — pace prescriptions for the
  /// athlete's own fitness still come from their resolved pace table.
  targetPaces String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, date])
}

/// Phone verification codes. Separate from User so a code has a lifetime, an
/// attempt count, and an audit trail rather than being a mutable field on the
/// account it protects.
model PhoneVerification {
  id     String @id @default(cuid())
  userId String

  /// The number this code was issued for, E.164. Held here rather than read from
  /// User at confirm time so that a code cannot be issued for one number and
  /// redeemed against another.
  phoneNumber String
  /// HMAC-SHA256 of the code, keyed with the app secret and bound to the number
  /// above — never the code itself. Keyed rather than a bare hash because a
  /// plain digest of six digits is reversible by trying all million inputs, so
  /// a leaked database dump would hand over every live code.
  codeHash    String
  expiresAt   DateTime
  /// Incremented per failed confirmation. A six-digit code is trivially
  /// brute-forceable without a ceiling on guesses.
  attempts    Int       @default(0)
  consumedAt  DateTime?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
